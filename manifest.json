{
  "manifest_version": 3,
  "name": "BountyRadar - Fresh Bounty & VDP Hunter",
  "version": "1.4.0",
  "description": "Autonomously discovers newly published, self-hosted, and unlisted bug bounty programs without having to visit websites.",
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "tabs"],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "https://raw.githubusercontent.com/*",
    "https://api.telegram.org/*",
    "https://api.resend.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["feeds.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BountyRadar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bountyradar@tejassroot.github.io",
      "strict_min_version": "109.0",
      "update_url": "https://raw.githubusercontent.com/tejassroot/BountyRadar/main/updates.json"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
